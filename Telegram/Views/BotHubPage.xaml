<local:HostedPage x:Class="Telegram.Views.BotHubPage"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="using:Telegram.Views"
                  xmlns:controls="using:Telegram.Controls"
                  xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
                  xmlns:viewModels="using:Telegram.ViewModels"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  mc:Ignorable="d"
                  NavigationMode="Root">

    <Grid Background="{ThemeResource SettingsPageBackground}">
        <ScrollViewer x:Name="ScrollingHost"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto">
            <controls:SettingsPanel>

                <!-- App Format & Markup Section -->
                <controls:HeaderedControl Header="{CustomResource BotHubAppFormatSection}">
                    <RadioButton IsChecked="{x:Bind ViewModel.IsFormatHtml, Mode=TwoWay}"
                                 Content="{CustomResource BotHubAppFormatHtml}"
                                 Style="{StaticResource SettingsRadioButtonStyle}" />
                    <RadioButton IsChecked="{x:Bind ViewModel.IsFormatMarkdown, Mode=TwoWay}"
                                 Content="{CustomResource BotHubAppFormatMarkdown}"
                                 Style="{StaticResource SettingsRadioButtonStyle}" />
                    <RadioButton IsChecked="{x:Bind ViewModel.IsFormatPlainText, Mode=TwoWay}"
                                 Content="{CustomResource BotHubAppFormatPlainText}"
                                 Style="{StaticResource SettingsRadioButtonStyle}" />
                    <RadioButton IsChecked="{x:Bind ViewModel.IsMarkupInlineKeyboard, Mode=TwoWay}"
                                 Content="{CustomResource BotHubMarkupInlineKeyboard}"
                                 Style="{StaticResource SettingsRadioButtonStyle}" />
                    <RadioButton IsChecked="{x:Bind ViewModel.IsMarkupReplyKeyboard, Mode=TwoWay}"
                                 Content="{CustomResource BotHubMarkupReplyKeyboard}"
                                 Style="{StaticResource SettingsRadioButtonStyle}" />
                    <RadioButton IsChecked="{x:Bind ViewModel.IsMarkupForceReply, Mode=TwoWay}"
                                 Content="{CustomResource BotHubMarkupForceReply}"
                                 Style="{StaticResource SettingsRadioButtonStyle}" />
                </controls:HeaderedControl>

                <!-- Bot Search & Presets Section -->
                <controls:HeaderedControl Header="{CustomResource BotHubBotPresetsSection}">
                    <TextBox x:Name="BotSearchBox"
                             Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="{CustomResource Search}"
                             FontFamily="{ThemeResource EmojiThemeFontFamily}"
                             TextWrapping="Wrap"
                             Padding="12,11,6,12" />
                    <muxc:ItemsRepeater x:Name="PresetsRepeater"
                                        ItemsSource="{x:Bind ViewModel.BotPresets, Mode=OneWay}">
                        <muxc:ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:BotHubPreset">
                                <Grid Padding="12,8"
                                      Background="{ThemeResource SettingsItemBackground}"
                                      BorderBrush="{ThemeResource SettingsItemBorderBrush}">
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                                   Style="{StaticResource BaseTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind Description, Mode=OneWay}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource SystemControlDisabledChromeDisabledLowBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </muxc:ItemsRepeater.ItemTemplate>
                    </muxc:ItemsRepeater>
                </controls:HeaderedControl>

                <!-- Bot Tasks TODO Section -->
                <controls:HeaderedControl Header="{CustomResource BotHubBotTasksSection}">
                    <muxc:ItemsRepeater x:Name="BotTasksRepeater"
                                        ItemsSource="{x:Bind ViewModel.BotTasks, Mode=OneWay}">
                        <muxc:ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:BotHubTaskItem">
                                <CheckBox IsChecked="{x:Bind IsDone, Mode=TwoWay}"
                                          Content="{x:Bind Title, Mode=OneWay}"
                                          Style="{StaticResource SettingsCheckBoxStyle}" />
                            </DataTemplate>
                        </muxc:ItemsRepeater.ItemTemplate>
                    </muxc:ItemsRepeater>
                    <Grid Padding="12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NewBotTaskBox"
                                 PlaceholderText="{CustomResource BotHubAddTask}"
                                 FontFamily="{ThemeResource EmojiThemeFontFamily}"
                                 Padding="12,11,6,12" />
                        <controls:GlyphButton Click="AddBotTask_Click"
                                              Glyph="&#xE109;"
                                              Grid.Column="1" />
                    </Grid>
                </controls:HeaderedControl>

                <!-- Agent Projects TODO Section -->
                <controls:HeaderedControl Header="{CustomResource BotHubAgentTasksSection}">
                    <muxc:ItemsRepeater x:Name="AgentTasksRepeater"
                                        ItemsSource="{x:Bind ViewModel.AgentTasks, Mode=OneWay}">
                        <muxc:ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:BotHubTaskItem">
                                <CheckBox IsChecked="{x:Bind IsDone, Mode=TwoWay}"
                                          Content="{x:Bind Title, Mode=OneWay}"
                                          Style="{StaticResource SettingsCheckBoxStyle}" />
                            </DataTemplate>
                        </muxc:ItemsRepeater.ItemTemplate>
                    </muxc:ItemsRepeater>
                    <Grid Padding="12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NewAgentTaskBox"
                                 PlaceholderText="{CustomResource BotHubAddTask}"
                                 FontFamily="{ThemeResource EmojiThemeFontFamily}"
                                 Padding="12,11,6,12" />
                        <controls:GlyphButton Click="AddAgentTask_Click"
                                              Glyph="&#xE109;"
                                              Grid.Column="1" />
                    </Grid>
                </controls:HeaderedControl>

                <!-- Environment Deployment TODO Section -->
                <controls:HeaderedControl Header="{CustomResource BotHubDeploymentTasksSection}">
                    <muxc:ItemsRepeater x:Name="DeploymentTasksRepeater"
                                        ItemsSource="{x:Bind ViewModel.DeploymentTasks, Mode=OneWay}">
                        <muxc:ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:BotHubTaskItem">
                                <CheckBox IsChecked="{x:Bind IsDone, Mode=TwoWay}"
                                          Content="{x:Bind Title, Mode=OneWay}"
                                          Style="{StaticResource SettingsCheckBoxStyle}" />
                            </DataTemplate>
                        </muxc:ItemsRepeater.ItemTemplate>
                    </muxc:ItemsRepeater>
                    <Grid Padding="12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NewDeploymentTaskBox"
                                 PlaceholderText="{CustomResource BotHubAddTask}"
                                 FontFamily="{ThemeResource EmojiThemeFontFamily}"
                                 Padding="12,11,6,12" />
                        <controls:GlyphButton Click="AddDeploymentTask_Click"
                                              Glyph="&#xE109;"
                                              Grid.Column="1" />
                    </Grid>
                </controls:HeaderedControl>

            </controls:SettingsPanel>
        </ScrollViewer>
    </Grid>
</local:HostedPage>

